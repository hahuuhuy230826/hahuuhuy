<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bảng Báo Giá Xe & Tính Hoa Hồng</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap');
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f1f5f9;
        }
        .excel-table th, .excel-table td {
            border: 1px solid #cbd5e1;
            padding: 6px 10px;
        }
        .header-blue {
            background-color: #0066cc;
            color: white;
        }
        .header-yellow {
            background-color: #facc15;
            color: #000;
            font-weight: 700;
        }
        .header-sub-blue {
            background-color: #0284c7;
            color: white;
            font-weight: 700;
        }
        input[type="number"], input[type="text"] {
            border: 1px solid transparent;
            background: transparent;
            width: 100%;
            transition: all 0.2s;
        }
        input[type="number"]:hover, input[type="text"]:hover,
        input[type="number"]:focus, input[type="text"]:focus {
            border: 1px solid #3b82f6;
            background: #ffffff;
            border-radius: 4px;
            outline: none;
            padding: 2px 4px;
        }
        .num-input {
            text-align: right;
            font-weight: 500;
        }
        @media print {
            .no-print {
                display: none !important;
            }
            body {
                background: white;
            }
            .shadow-lg {
                box-shadow: none !important;
            }
        }
    </style>
</head>
<body class="p-2 md:p-6 text-slate-800">

    <!-- Top Action Bar -->
    <div class="max-w-7xl mx-auto mb-4 bg-white p-4 rounded-xl shadow flex flex-wrap gap-3 justify-between items-center no-print">
        <div class="flex items-center gap-2">
            <span class="p-2 bg-blue-600 text-white rounded-lg"><i class="fa-solid fa-car"></i></span>
            <div>
                <h1 class="font-bold text-lg text-slate-800">Bảng Tính Báo Giá Xe & Lợi Nhuận</h1>
                <p class="text-xs text-slate-500">Tự động tính toán giá lăn bánh, trả góp, voucher & hoa hồng</p>
            </div>
        </div>
        <div class="flex flex-wrap gap-2">
            <button onclick="toggleInternalView()" id="btnToggleInternal" class="px-3 py-2 bg-slate-700 hover:bg-slate-800 text-white text-xs font-semibold rounded-lg shadow transition flex items-center gap-1.5">
                <i class="fa-solid fa-eye-slash"></i> <span>Ẩn / Hiện Bảng Nội Bộ</span>
            </button>
            <button onclick="exportImage()" class="px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg shadow transition flex items-center gap-1.5">
                <i class="fa-solid fa-camera"></i> <span>Xuất Ảnh Gửi Khách</span>
            </button>
            <button onclick="window.print()" class="px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg shadow transition flex items-center gap-1.5">
                <i class="fa-solid fa-print"></i> <span>In Báo Giá</span>
            </button>
            <button onclick="resetDefaults()" class="px-3 py-2 bg-gray-200 hover:bg-gray-300 text-slate-700 text-xs font-semibold rounded-lg shadow transition flex items-center gap-1.5">
                <i class="fa-solid fa-rotate-left"></i> <span>Mặc Định</span>
            </button>
        </div>
    </div>

    <!-- Main Container -->
    <div id="exportArea" class="max-w-7xl mx-auto bg-white p-4 md:p-6 rounded-xl shadow-lg">
        
        <!-- Document Title -->
        <div class="text-center mb-4 border-b pb-3">
            <input type="text" id="docTitle" value="Kính Gửi Quý Khách Hàng Bảng Báo Giá Xe VinFast 7 chỗ" 
                   class="text-xl md:text-2xl font-black text-center text-blue-900 uppercase tracking-wide w-full">
            <div class="flex justify-between items-center text-xs text-slate-500 mt-1 px-2">
                <span>Tư vấn bán hàng: <input type="text" value="Hà Hữu Huy - 09xx.xxx.xxx" class="font-medium text-slate-700 inline-block w-auto border-b border-dashed"></span>
                <span>Ngày báo giá: <span id="currentDate"></span></span>
            </div>
        </div>

        <!-- Grid Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- LEFT COLUMN: BÁO GIÁ KHÁCH HÀNG (7 or 12 Cols) -->
            <div id="customerSection" class="lg:col-span-7 transition-all">
                <div class="overflow-x-auto">
                    <table class="w-full text-xs md:text-sm excel-table bg-white">
                        <thead>
                            <tr class="header-blue text-center font-bold">
                                <th style="width: 8%;">STT</th>
                                <th style="width: 48%;">HẠNG MỤC</th>
                                <th style="width: 20%;">Phiên bản</th>
                                <th style="width: 24%;" class="text-right">
                                    <input type="text" id="carVersion" value="Limo Green" class="text-white font-bold text-center">
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- I. GIÁ XE NIÊM YẾT -->
                            <tr class="header-yellow">
                                <td class="text-center font-bold">I.</td>
                                <td colspan="2" class="font-bold">Giá xe niêm yết</td>
                                <td class="text-right font-bold">
                                    <input type="number" id="listPrice" value="699000000" step="1000000" class="num-input font-bold" oninput="calculate()">
                                </td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Chương trình khuyến mãi tháng</td>
                                <td class="text-center"><input type="text" value="Tháng 8" class="text-center text-xs text-slate-600"></td>
                                <td><input type="number" id="promoMonth" value="35000000" step="500000" class="num-input text-red-600" oninput="calculate()"></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Chiết khấu từ đại lý</td>
                                <td></td>
                                <td><input type="number" id="dealerDiscount" value="12000000" step="500000" class="num-input text-red-600" oninput="calculate()"></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Khách hàng có hạng VinClub giảm</td>
                                <td class="text-center">
                                    <div class="flex items-center justify-center gap-1">
                                        <input type="number" id="vinclubPercent" value="0.5" step="0.1" class="w-10 text-center font-semibold" oninput="calculate()">%
                                    </div>
                                </td>
                                <td><input type="number" id="vinclubAmount" value="3320000" class="num-input text-red-600" readonly></td>
                            </tr>
                            <!-- VOUCHER ROW (NEW) -->
                            <tr class="bg-amber-50">
                                <td></td>
                                <td class="font-medium text-amber-900">
                                    <input type="text" id="voucherName" value="Voucher VinFast / Sống Xanh" class="font-medium">
                                </td>
                                <td class="text-center text-xs text-amber-800">Trừ trực tiếp</td>
                                <td><input type="number" id="voucherAmount" value="0" step="1000000" class="num-input font-bold text-red-600" placeholder="0" oninput="calculate()"></td>
                            </tr>
                            <tr class="font-bold bg-slate-100">
                                <td></td>
                                <td colspan="2">Tổng cộng giá xe (Sau khuyến mãi & Voucher)</td>
                                <td class="text-right text-blue-700 font-extrabold" id="netCarPrice">0 đ</td>
                            </tr>

                            <!-- II. CHI PHÍ ĐĂNG KÝ BẤM BIỂN SỐ -->
                            <tr class="header-yellow">
                                <td class="text-center font-bold">II.</td>
                                <td colspan="3" class="font-bold">Chi phí đăng ký bấm biển số</td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Thuế trước bạ</td>
                                <td colspan="2" class="text-right">
                                    <input type="text" id="regTax" value="Miễn phí" class="text-right font-medium text-emerald-700">
                                </td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Phí cấp biển số xe</td>
                                <td colspan="2"><input type="number" id="plateFee" value="14000000" step="500000" class="num-input" oninput="calculate()"></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Phí đăng kiểm</td>
                                <td colspan="2"><input type="number" id="inspectFee" value="90000" step="10000" class="num-input" oninput="calculate()"></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Phí bảo trì đường bộ (1 năm)</td>
                                <td colspan="2"><input type="number" id="roadFee" value="2160000" step="100000" class="num-input" oninput="calculate()"></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Bảo hiểm trách nhiệm dân sự (TNDS)</td>
                                <td colspan="2"><input type="number" id="tndsFee" value="1200000" step="50000" class="num-input" oninput="calculate()"></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Bảo hiểm thân vỏ</td>
                                <td colspan="2"><input type="number" id="bodyInsuranceFee" value="9081520" step="100000" class="num-input" oninput="calculate()"></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Phí dịch vụ đăng ký trọn gói</td>
                                <td colspan="2"><input type="number" id="serviceFee" value="3000000" step="500000" class="num-input" oninput="calculate()"></td>
                            </tr>
                            <tr class="font-bold bg-slate-100">
                                <td></td>
                                <td colspan="2">Tổng cộng chi phí đăng ký xe</td>
                                <td class="text-right font-extrabold text-slate-800" id="totalRegistrationFee">0 đ</td>
                            </tr>

                            <!-- III. TỔNG CỘNG GIÁ LĂN BÁNH -->
                            <tr class="header-yellow text-sm md:text-base">
                                <td class="text-center font-bold">III.</td>
                                <td colspan="2" class="font-black uppercase">Tổng cộng giá lăn bánh (I + II)</td>
                                <td class="text-right font-black text-red-700" id="totalOnRoadPrice">0 đ</td>
                            </tr>

                            <!-- HÌNH THỨC TRẢ GÓP -->
                            <tr class="header-sub-blue text-center">
                                <td colspan="4" class="uppercase tracking-wider">ĐỐI VỚI HÌNH THỨC TRẢ GÓP</td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Khách hàng thanh toán vốn tự có</td>
                                <td class="text-center font-semibold">
                                    <div class="flex items-center justify-center gap-1">
                                        <input type="number" id="downPaymentPercent" value="15" step="5" min="10" max="90" class="w-10 text-center font-bold" oninput="updateLoanFromPercent()">%
                                    </div>
                                </td>
                                <td class="text-right font-bold text-slate-700" id="downPaymentAmount">0 đ</td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Ngân hàng hỗ trợ vay</td>
                                <td class="text-center font-semibold" id="loanPercentText">85%</td>
                                <td class="text-right font-bold text-slate-700" id="loanAmount">0 đ</td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Tạm tính lãi suất vay</td>
                                <td class="text-center">
                                    <div class="flex items-center justify-center gap-0.5 text-xs font-semibold">
                                        <input type="number" id="interestRate" value="10.5" step="0.1" class="w-10 text-center font-bold" oninput="calculate()">%/năm
                                    </div>
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td>Thời gian vay ngân hàng</td>
                                <td class="text-center">
                                    <div class="flex items-center justify-center gap-1">
                                        <input type="number" id="loanMonths" value="96" step="12" min="12" max="96" class="w-10 text-center font-bold" oninput="calculate()"> tháng
                                    </div>
                                </td>
                                <td class="text-right">
                                    <span class="text-[10px] text-slate-500 block">Dự kiến trả tháng đầu:</span>
                                    <span class="font-black text-blue-700 text-sm" id="monthlyPayment">0 đ</span>
                                </td>
                            </tr>

                            <!-- IV. TỔNG SỐ TIỀN TRẢ TRƯỚC -->
                            <tr class="header-yellow">
                                <td class="text-center font-bold">IV.</td>
                                <td colspan="2" class="font-black uppercase">Tổng số tiền trả trước nhận xe</td>
                                <td class="text-right font-black text-red-700 text-sm md:text-base" id="initialPayment">0 đ</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="mt-2 text-[11px] text-slate-500 italic">
                    * Báo giá đã bao gồm các chương trình ưu đãi hiện hành và có giá trị tại thời điểm lập báo giá.
                </div>
            </div>

            <!-- RIGHT COLUMN: BẢNG TÍNH LỢI NHUẬN NỘI BỘ & QUÀ TẶNG (5 Cols) -->
            <div id="internalSection" class="lg:col-span-5 bg-slate-50 p-3 rounded-lg border border-slate-200">
                <div class="text-center font-bold text-slate-700 pb-2 mb-2 border-b border-slate-300 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-calculator text-blue-600"></i>
                    <span>TÍNH TOÁN HOA HỒNG & CHI PHÍ NỘI BỘ</span>
                </div>

                <!-- Bảng tính hoa hồng xe -->
                <table class="w-full text-xs excel-table bg-white mb-4">
                    <tbody>
                        <tr>
                            <td class="font-medium" style="width: 58%;">Lương xe / Thưởng định mức</td>
                            <td class="text-right font-bold" style="width: 42%;">
                                <input type="number" id="carSalary" value="35000000" step="500000" class="num-input text-blue-700 font-bold" oninput="calculate()">
                            </td>
                        </tr>
                        <tr>
                            <td class="font-medium text-red-600">Giảm thêm cho khách</td>
                            <td class="text-right">
                                <input type="number" id="saleDiscountForCustomer" value="12000000" step="500000" class="num-input text-red-600" oninput="calculate()">
                            </td>
                        </tr>
                        <tr>
                            <td class="font-medium text-slate-600">TVBH bị trừ 25% VinClub</td>
                            <td class="text-right text-slate-700 font-semibold" id="tvbhVinclubCut">0 đ</td>
                        </tr>
                        <tr class="bg-red-50 font-bold">
                            <td class="italic text-red-700">Lương xe còn lại</td>
                            <td class="text-right text-red-700 font-bold" id="remainingSalary">0 đ</td>
                        </tr>
                        <tr>
                            <td class="font-medium">Hoa hồng Bảo hiểm thân vỏ (BHTV)</td>
                            <td class="text-right">
                                <input type="number" id="commBodyInsurance" value="1453043" step="50000" class="num-input" oninput="calculate()">
                            </td>
                        </tr>
                        <tr>
                            <td class="font-medium">Hoa hồng Bảo hiểm TNDS</td>
                            <td class="text-right">
                                <input type="number" id="commTnds" value="192000" step="10000" class="num-input" oninput="calculate()">
                            </td>
                        </tr>
                        <tr class="bg-slate-100 font-bold">
                            <td class="text-red-600">Tổng HH trước thuế</td>
                            <td class="text-right text-red-600 font-bold" id="totalCommBeforeTax">0 đ</td>
                        </tr>
                        <tr>
                            <td class="text-slate-600">Giảm trừ thuế TNCN (- 10%)</td>
                            <td class="text-right text-slate-600" id="taxDeduction">0 đ</td>
                        </tr>
                        <tr class="bg-amber-50 font-bold">
                            <td class="text-red-700 italic">HH còn lại sau thuế</td>
                            <td class="text-right text-red-700 font-bold" id="commAfterTax">0 đ</td>
                        </tr>
                        <tr>
                            <td class="text-slate-600 italic">Trừ quà tặng khuyến mãi</td>
                            <td class="text-right text-slate-700 font-semibold" id="giftCostDeduction">0 đ</td>
                        </tr>
                        <!-- Chia tỷ lệ GT / Sale -->
                        <tr class="bg-blue-50 font-bold">
                            <td class="text-red-600">
                                GT (<input type="number" id="gtPercent" value="70" class="w-8 text-center bg-transparent border-b border-red-300" oninput="calculate()">%)
                            </td>
                            <td class="text-right text-red-700 font-extrabold" id="gtEarning">0 đ</td>
                        </tr>
                        <tr class="bg-emerald-50 font-bold">
                            <td class="text-emerald-800">
                                Sale (<input type="number" id="salePercent" value="30" class="w-8 text-center bg-transparent border-b border-emerald-300" oninput="calculate()">%)
                            </td>
                            <td class="text-right text-emerald-800 font-extrabold" id="saleEarning">0 đ</td>
                        </tr>
                    </tbody>
                </table>

                <!-- Bảng danh sách quà tặng kèm -->
                <div class="flex justify-between items-center mb-1">
                    <span class="text-xs font-bold text-slate-700 uppercase">Danh Mục Quà Tặng Kèm Xe</span>
                    <button onclick="addGiftRow()" class="text-[11px] bg-blue-100 hover:bg-blue-200 text-blue-700 px-2 py-0.5 rounded font-medium">+ Thêm quà</button>
                </div>
                <table class="w-full text-xs excel-table bg-white" id="giftTable">
                    <thead>
                        <tr class="bg-slate-200 text-slate-700 font-semibold text-center">
                            <th>Tên Quà Tặng</th>
                            <th class="w-28 text-right">Chi phí (đ)</th>
                            <th class="w-6 no-print"></th>
                        </tr>
                    </thead>
                    <tbody id="giftListBody">
                        <tr>
                            <td><input type="text" value="Lót sàn" class="gift-name"></td>
                            <td><input type="number" value="550000" class="gift-price num-input" oninput="calculate()"></td>
                            <td class="text-center no-print"><button onclick="removeRow(this)" class="text-red-400 hover:text-red-600">×</button></td>
                        </tr>
                        <tr>
                            <td><input type="text" value="Cam hành trình" class="gift-name"></td>
                            <td><input type="number" value="500000" class="gift-price num-input" oninput="calculate()"></td>
                            <td class="text-center no-print"><button onclick="removeRow(this)" class="text-red-400 hover:text-red-600">×</button></td>
                        </tr>
                        <tr>
                            <td><input type="text" value="Phim cách nhiệt" class="gift-name"></td>
                            <td><input type="number" value="900000" class="gift-price num-input" oninput="calculate()"></td>
                            <td class="text-center no-print"><button onclick="removeRow(this)" class="text-red-400 hover:text-red-600">×</button></td>
                        </tr>
                        <tr>
                            <td><input type="text" value="Bọc biển số" class="gift-name"></td>
                            <td><input type="number" value="300000" class="gift-price num-input" oninput="calculate()"></td>
                            <td class="text-center no-print"><button onclick="removeRow(this)" class="text-red-400 hover:text-red-600">×</button></td>
                        </tr>
                        <tr>
                            <td><input type="text" value="Rửa xe + dán Vetc" class="gift-name"></td>
                            <td><input type="number" value="150000" class="gift-price num-input" oninput="calculate()"></td>
                            <td class="text-center no-print"><button onclick="removeRow(this)" class="text-red-400 hover:text-red-600">×</button></td>
                        </tr>
                        <tr>
                            <td><input type="text" value="Grap giao hồ sơ" class="gift-name"></td>
                            <td><input type="number" value="150000" class="gift-price num-input" oninput="calculate()"></td>
                            <td class="text-center no-print"><button onclick="removeRow(this)" class="text-red-400 hover:text-red-600">×</button></td>
                        </tr>
                        <tr>
                            <td><input type="text" value="Hoa giao xe" class="gift-name"></td>
                            <td><input type="number" value="250000" class="gift-price num-input" oninput="calculate()"></td>
                            <td class="text-center no-print"><button onclick="removeRow(this)" class="text-red-400 hover:text-red-600">×</button></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="font-bold bg-amber-50">
                            <td class="text-red-600 font-bold">Tổng quà tặng</td>
                            <td class="text-right text-red-600 font-extrabold" id="totalGiftCost">2.800.000 đ</td>
                            <td class="no-print"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

        </div>

        <!-- Footer Contact Info -->
        <div class="mt-6 pt-4 border-t text-xs text-slate-500 flex flex-wrap justify-between items-center">
            <div>
                <p class="font-bold text-slate-700">ĐẠI LÝ VINFAST CHÍNH HÃNG</p>
                <p>Hỗ trợ lái thử tận nhà & tư vấn thủ tục ngân hàng trọn gói.</p>
            </div>
            <div class="text-right mt-2 sm:mt-0 font-medium">
                <p>Hotline tư vấn 24/7: <span class="font-bold text-blue-600">09xx.xxx.xxx</span></p>
            </div>
        </div>

    </div>

    <!-- JavaScript Calculation Engine -->
    <script>
        function fmt(n) {
            return Math.round(n).toLocaleString('vi-VN') + ' đ';
        }

        function val(id) {
            const el = document.getElementById(id);
            return el ? (parseFloat(el.value) || 0) : 0;
        }

        function calculate() {
            // 1. I. GIÁ XE
            const listPrice = val('listPrice');
            const promoMonth = val('promoMonth');
            const dealerDiscount = val('dealerDiscount');
            const vinclubPercent = val('vinclubPercent');
            const voucherAmount = val('voucherAmount');

            // Tính tiền VinClub
            const vinclubAmount = Math.round(listPrice * (vinclubPercent / 100));
            document.getElementById('vinclubAmount').value = vinclubAmount;

            // Giá xe sau giảm
            const netCarPrice = Math.max(0, listPrice - promoMonth - dealerDiscount - vinclubAmount - voucherAmount);
            document.getElementById('netCarPrice').innerText = fmt(netCarPrice);

            // 2. II. CHI PHÍ ĐĂNG KÝ
            const plateFee = val('plateFee');
            const inspectFee = val('inspectFee');
            const roadFee = val('roadFee');
            const tndsFee = val('tndsFee');
            const bodyInsuranceFee = val('bodyInsuranceFee');
            const serviceFee = val('serviceFee');

            const totalRegistrationFee = plateFee + inspectFee + roadFee + tndsFee + bodyInsuranceFee + serviceFee;
            document.getElementById('totalRegistrationFee').innerText = fmt(totalRegistrationFee);

            // 3. III. GIÁ LĂN BÁNH
            const totalOnRoadPrice = netCarPrice + totalRegistrationFee;
            document.getElementById('totalOnRoadPrice').innerText = fmt(totalOnRoadPrice);

            // 4. TRẢ GÓP
            const downPaymentPercent = val('downPaymentPercent');
            const loanPercent = Math.max(0, 100 - downPaymentPercent);
            document.getElementById('loanPercentText').innerText = loanPercent + '%';

            // Tiền trả trước theo xe
            const downPaymentAmount = Math.round(netCarPrice * (downPaymentPercent / 100));
            const loanAmount = netCarPrice - downPaymentAmount;

            document.getElementById('downPaymentAmount').innerText = fmt(downPaymentAmount);
            document.getElementById('loanAmount').innerText = fmt(loanAmount);

            // Tính ước tính trả mỗi tháng (Gốc + Lãi tháng đầu theo dư nợ giảm dần)
            const interestRate = val('interestRate') / 100;
            const loanMonths = Math.max(1, val('loanMonths'));
            
            const principalPerMonth = loanAmount / loanMonths;
            const firstMonthInterest = loanAmount * (interestRate / 12);
            const estMonthlyPayment = principalPerMonth + firstMonthInterest;
            document.getElementById('monthlyPayment').innerText = fmt(estMonthlyPayment);

            // 5. IV. TỔNG TIỀN BAN ĐẦU
            const initialPayment = downPaymentAmount + totalRegistrationFee;
            document.getElementById('initialPayment').innerText = fmt(initialPayment);

            // 6. TÍNH QUÀ TẶNG
            let totalGift = 0;
            document.querySelectorAll('.gift-price').forEach(input => {
                totalGift += (parseFloat(input.value) || 0);
            });
            document.getElementById('totalGiftCost').innerText = fmt(totalGift);

            // 7. BẢNG TÍNH HOA HỒNG NỘI BỘ
            const carSalary = val('carSalary');
            const saleDiscount = val('saleDiscountForCustomer');
            const tvbhVinclubCut = Math.round(vinclubAmount * 0.25);
            document.getElementById('tvbhVinclubCut').innerText = fmt(tvbhVinclubCut);

            const remainingSalary = carSalary - saleDiscount - tvbhVinclubCut;
            document.getElementById('remainingSalary').innerText = fmt(remainingSalary);

            const commBody = val('commBodyInsurance');
            const commTnds = val('commTnds');

            const totalCommBeforeTax = remainingSalary + commBody + commTnds;
            document.getElementById('totalCommBeforeTax').innerText = fmt(totalCommBeforeTax);

            const taxDeduction = Math.round(totalCommBeforeTax * 0.10);
            document.getElementById('taxDeduction').innerText = fmt(taxDeduction);

            const commAfterTax = totalCommBeforeTax - taxDeduction;
            document.getElementById('commAfterTax').innerText = fmt(commAfterTax);

            document.getElementById('giftCostDeduction').innerText = fmt(totalGift);

            const netProfitAfterGift = commAfterTax - totalGift;

            const gtPercent = val('gtPercent');
            const salePercent = val('salePercent');

            const gtEarning = Math.round(netProfitAfterGift * (gtPercent / 100));
            const saleEarning = Math.round(netProfitAfterGift * (salePercent / 100));

            document.getElementById('gtEarning').innerText = fmt(gtEarning);
            document.getElementById('saleEarning').innerText = fmt(saleEarning);
        }

        function updateLoanFromPercent() {
            calculate();
        }

        function addGiftRow() {
            const tbody = document.getElementById('giftListBody');
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td><input type="text" value="Phụ kiện mới" class="gift-name"></td>
                <td><input type="number" value="0" class="gift-price num-input" oninput="calculate()"></td>
                <td class="text-center no-print"><button onclick="removeRow(this)" class="text-red-400 hover:text-red-600">×</button></td>
            `;
            tbody.appendChild(tr);
            calculate();
        }

        function removeRow(btn) {
            btn.closest('tr').remove();
            calculate();
        }

        let isInternalVisible = true;
        function toggleInternalView() {
            const internalSec = document.getElementById('internalSection');
            const customerSec = document.getElementById('customerSection');
            const btn = document.getElementById('btnToggleInternal');

            isInternalVisible = !isInternalVisible;
            if (isInternalVisible) {
                internalSec.style.display = 'block';
                customerSec.className = 'lg:col-span-7 transition-all';
                btn.innerHTML = '<i class="fa-solid fa-eye-slash"></i> <span>Ẩn Bảng Nội Bộ</span>';
            } else {
                internalSec.style.display = 'none';
                customerSec.className = 'lg:col-span-12 transition-all';
                btn.innerHTML = '<i class="fa-solid fa-eye"></i> <span>Hiện Bảng Nội Bộ</span>';
            }
        }

        function exportImage() {
            const exportArea = document.getElementById('exportArea');
            html2canvas(exportArea, {
                scale: 2,
                useCORS: true
            }).then(canvas => {
                const link = document.createElement('a');
                link.download = 'Bang-Bao-Gia-Xe.png';
                link.href = canvas.toDataURL('image/png');
                link.click();
            });
        }

        function resetDefaults() {
            location.reload();
        }

        // Set date
        const today = new Date();
        document.getElementById('currentDate').innerText = `${today.getDate()}/${today.getMonth()+1}/${today.getFullYear()}`;

        // Initialize calculation
        window.onload = calculate;
    </script>
</body>
</html>
